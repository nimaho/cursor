{
  "name": "bootstrap-5-simple-page",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "sass scss/styles.scss assets/css/styles.css --style=compressed",
    "watch:css": "sass scss/styles.scss assets/css/styles.css --watch",
    "start": "concurrently -k \"npm run watch:css\" \"live-server --port=5173 --no-browser\""
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "live-server": "^1.2.2",
    "sass": "^1.81.0"
  }
}

